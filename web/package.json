{
  "name": "webcam-magic-tracking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:extract": "node scripts/extract-game-assets.mjs",
    "assets:verify": "node scripts/verify-build-assets.mjs",
    "predev": "npm run setup && npm run assets:extract",
    "prebuild": "npm run setup && npm run assets:extract",
    "setup": "node scripts/setup-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "evaluate": "node scripts/evaluate-captures.mjs",
    "build": "tsc --noEmit && vite build && npm run assets:verify",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "rolldown": "1.2.11",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
